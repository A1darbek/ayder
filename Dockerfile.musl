# Dockerfile.musl (Alpine/musl build + runtime)
# Usage:
#   docker build -f Dockerfile.musl -t ayder:musl .
#   docker run --rm -it --shm-size=256m -e RF_SHARED_ENTRIES=262144 -p 1109:1109 ayder:musl

############################
# 1) BUILD (musl)
############################
FROM alpine:3.20 AS build

RUN apk add --no-cache \
    build-base linux-headers \
    ca-certificates curl \
    pkgconf \
    libuv-dev libevent-dev \
    liburing-dev \
    curl-dev openssl-dev zlib-dev

WORKDIR /app

# Copy repo
COPY . .

RUN test -f deps/picohttpparser/picohttpparser.c && \
    test -f deps/picohttpparser/picohttpparser.h && \
    make portable

############################
# 2) RUNTIME (musl)
############################
FROM alpine:3.20 AS runtime

RUN apk add --no-cache \
    ca-certificates \
    libuv libevent \
    liburing \
    curl openssl zlib && \
    addgroup -S -g 10001 ayder && \
    adduser -S -D -H -u 10001 -G ayder ayder

WORKDIR /app
RUN mkdir -p /data /app && chown -R ayder:ayder /data /app

# Copy binary (+ optional entrypoint if you have it)
COPY --chown=ayder:ayder --from=build /app/build/portable/ayder ./ayder
# If your repo has entrypoint.sh, keep it; otherwise this is harmless to remove.
COPY --chown=ayder:ayder --from=build /app/entrypoint.sh ./entrypoint.sh
RUN if [ -f ./entrypoint.sh ]; then chmod +x ./entrypoint.sh; fi

EXPOSE 1109
USER 10001:10001
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
  CMD curl -fsS http://127.0.0.1:1109/ready | grep -Eq '"ready"[[:space:]]*:[[:space:]]*true' || exit 1

# If you have entrypoint.sh and want it:
ENTRYPOINT ["./entrypoint.sh"]
# Otherwise, comment ENTRYPOINT above and use:
# ENTRYPOINT ["./ayder"]

CMD ["./ayder", "--workers", "4"]
