      "name": "DS_PROMETHEUS",
      "pluginId": "prometheus",
      "pluginName": "Prometheus",
      "type": "datasource"
    }
  ],
  "annotations": {
    "list": []
  },
  "description": "Dashboard limited to metrics exported by the current Ayder implementation.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "content": "This dashboard intentionally omits disk capacity/error detail and replication lag because the current exporter has no trustworthy series for them. HTTP counters/request duration, operation, storage, recovery, and process series are shared across workers; persistence-duration histograms and queue gauges still require a stable/single-worker scrape. HTTP duration covers first request byte through handler completion, not proxy/network/client time. Metrics require bearer authentication by default but still travel over the client HTTP listener; keep them private and use a trusted TLS boundary.",
        "mode": "markdown"
      },
      "title": "Read before using",
      "type": "text"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.01
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 4
      },
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "max(up{job=\"ayder\",instance=~\"$instance\"})",
          "legendFormat": "up",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Scrape up",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
