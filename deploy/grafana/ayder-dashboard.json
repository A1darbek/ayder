      "targets": [
        {
          "editorMode": "code",
          "expr": "rate(ayder_http_requests_total{job=\"ayder\",instance=~\"$instance\"}[5m])",
          "legendFormat": "{{instance}}",
          "range": true,
          "refId": "A"
